# Copy this file to D:\projectsgit\实习项目1\.env for local configuration.
# Leave cloud settings blank until you have the provider URL and model name.
# Base URL example shape: https://provider.example/v1 (not /chat/completions).
TOOLFLOW_CLOUD_BASE_URL=
TOOLFLOW_CLOUD_MODEL=
TOOLFLOW_API_KEY=

# 可选：Ollama 的已有程序和模型目录；留空沿用本机默认，不自动下载。
# TOOLFLOW_OLLAMA_EXE=C:\Users\Administrator\AppData\Local\Programs\Ollama\ollama.exe
# TOOLFLOW_OLLAMA_MODELS=D:\OllamaLocal\models
