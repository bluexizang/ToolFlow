# 将此文件复制为项目根目录中的 .env，再填写本机配置。
# 获得供应商地址和模型名称后，再填写云端配置。
# 地址格式示例：https://provider.example/v1，不包含 /chat/completions。
TOOLFLOW_CLOUD_BASE_URL=
TOOLFLOW_CLOUD_MODEL=
TOOLFLOW_API_KEY=

# 可选：Ollama 的已有程序和模型目录；留空沿用本机默认，不自动下载。
# TOOLFLOW_OLLAMA_EXE=D:\Apps\Ollama\ollama.exe
# TOOLFLOW_OLLAMA_MODELS=D:\Models\Ollama
